{
  "name": "electron-trio",
  "version": "0.3.0",
  "description": "Simplify Electron application development and builds with Vite.",
  "keywords": [
    "electron",
    "vite-plugin",
    "type-safe",
    "rpc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "ye-e-e-e",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ye-e-e-e/electron-trio.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:electron": "pnpm build && vitest run --mode electron",
    "test:package": "pnpm build && vitest run --mode package",
    "prepare": "husky",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm test:package"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.4",
  "peerDependencies": {
    "electron": ">=44.0.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@rolldown/pluginutils": "^1.0.1",
    "@standard-schema/spec": "^1.1.0",
    "magic-string": "^1.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.4",
    "electron": "44.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.1"
  }
}
